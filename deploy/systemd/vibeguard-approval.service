[Unit]
Description=VibeGuard authenticated human approval service
Documentation=https://github.com/yagyeshVyas/VibeGuard/blob/master/docs/OPERATIONS.md
After=network.target
Wants=network.target

[Service]
Type=simple
User=vibeguard
Group=vibeguard
WorkingDirectory=/opt/vibeguard
EnvironmentFile=-/etc/vibeguard/approval.env
Environment=NODE_ENV=production
Environment=VIBEGUARD_APPROVAL_HOST=127.0.0.1
Environment=VIBEGUARD_APPROVAL_PORT=8787
Environment=VIBEGUARD_APPROVAL_STORE=/var/lib/vibeguard/approvals.json
Environment=VIBEGUARD_APPROVAL_AUDIT=/var/lib/vibeguard/approval-audit.jsonl
Environment=VIBEGUARD_APPROVAL_USERS=/etc/vibeguard/users.json
Environment=VIBEGUARD_APPROVAL_SIGNING_KEYS=/etc/vibeguard/signing-keys.json
Environment=VIBEGUARD_APPROVAL_KEY=/etc/vibeguard/approval-private.pem
Environment=VIBEGUARD_APPROVAL_IDENTITY_KEY=/etc/vibeguard/identity-private.pem
ExecStart=/usr/bin/node /opt/vibeguard/bin/cli.js approval serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=25s
KillSignal=SIGTERM
StateDirectory=vibeguard
StateDirectoryMode=0700
ConfigurationDirectory=vibeguard
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
