{
  "name": "@yagyeshvyas/vibeguard",
  "version": "1.13.3",
  "description": "Offline-by-default security scanner and runtime firewall for AI-coded apps and MCP agents. 861 rules, 93 MCP tools, signed default-deny policy, tool-poisoning/prompt-injection/secret-exfiltration detection, signed audit + external anchor, hosted approvals with signed proofs, HTTP/SSE MCP bridge with OAuth/TLS, Linux bubblewrap isolation, Windows Job containment and macOS sandbox-exec. Zero telemetry.",
  "license": "MIT",
  "type": "commonjs",
  "author": "Yagyesh Vyas <https://www.linkedin.com/in/yagyeshvyas/>",
  "homepage": "https://github.com/yagyeshVyas/VibeGuard",
  "repository": {
    "type": "git",
    "url": "https://github.com/yagyeshVyas/VibeGuard.git"
  },
  "bugs": {
    "url": "https://github.com/yagyeshVyas/VibeGuard/issues"
  },
  "bin": {
    "vibeguard": "bin/cli.js",
    "vibeguard-mcp": "src/mcp-server.js"
  },
  "files": [
    "bin",
    "src",
    "hooks",
    "ci",
    "ci-templates",
    "README.md",
    "CHANGELOG.md",
    "MCP-FIREWALL.md",
    "docs",
    ".vibeguard-mcp.example.json",
    "scripts"
  ],
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "ip-address": "^10.4.0",
    "hono": ">=4.13.8",
    "brace-expansion": "^5.0.13",
    "fast-uri": "^4.2.1",
    "js-yaml": "^5.2.3",
    "qs": ">=6.15.4",
    "proxy-addr": "^2.0.8",
    "body-parser": "^2.4.0",
    "zod": "^4.6.7"
  },
  "scripts": {
    "test": "node test/run.js",
    "test:platform": "node test/run-platform.js",
    "security-bench": "node scripts/security-bench.js",
    "scan": "node bin/cli.js scan",
    "lint": "eslint src/ bin/ --ignore-pattern node_modules",
    "coverage": "c8 node test/run.js",
    "counts": "node scripts/counts.js",
    "benchmark": "node test/benchmark/run.js",
    "integrity": "node scripts/gen-integrity.js",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "node scripts/gen-integrity.js && node test/run.js && npm run lint",
    "tokens": "node bin/cli.js tokens",
    "security-corpus": "node test/corpus/run.js --gate"
  },
