            {
              "id": "authz2026.mass-assignment-privileged-field",
              "name": "Request body spread into a write — privilege fields reachable",
              "shortDescription": {
                "text": "Request body spread into a write — privilege fields reachable"
              },
              "fullDescription": {
                "text": "The whole request body is written to a record. Generators do this as `prisma.user.update({ data: req.body })`; a caller can then set role/isAdmin/credits/plan fields the UI never exposes (mass assignment)."
              },
              "helpUri": "https://github.com/vibeguard/vibeguard#rules",
              "properties": {
                "security_severity": "high",
                "tags": [
                  "confidence:medium"
