{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "VibeGuard",
          "informationUri": "https://github.com/vibeguard/vibeguard",
          "version": "1.13.0",
          "rules": [
            {
              "id": "secret2026.private-key-block",
              "name": "Private key committed",
              "shortDescription": {
                "text": "Private key committed"
              },
              "fullDescription": {
                "text": "A private key is committed. Anything signed or encrypted with it is compromised until rotated — historical copies survive in forks and caches."
              },
              "helpUri": "https://github.com/vibeguard/vibeguard#rules",
              "properties": {
                "security_severity": "critical",
                "tags": [
                  "confidence:high"
                ]
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "ast.eval-dynamic",
              "name": "eval() with a non-literal argument (AST-confirmed)",
              "shortDescription": {
                "text": "eval() with a non-literal argument (AST-confirmed)"
              },
              "fullDescription": {
                "text": "eval() is called with a dynamic argument — arbitrary code execution."
              },
              "helpUri": "https://github.com/vibeguard/vibeguard#rules",
              "properties": {
                "security_severity": "critical",
                "tags": [
                  "confidence:high"
                ]
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "taint.code-injection",
              "name": "User input reaches eval()/Function() (dataflow-confirmed)",
              "shortDescription": {
                "text": "User input reaches eval()/Function() (dataflow-confirmed)"
              },
              "fullDescription": {
                "text": "A value derived from user input flows into eval()/new Function() — remote code execution. (tainted via `source`)"
              },
              "helpUri": "https://github.com/vibeguard/vibeguard#rules",
              "properties": {
                "security_severity": "critical",
                "tags": [
                  "confidence:high"
                ]
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "secret.generic-credential",
              "name": "Hardcoded credential",
              "shortDescription": {
                "text": "Hardcoded credential"
              },
              "fullDescription": {
                "text": "Looks like a hardcoded credential."
              },
              "helpUri": "https://github.com/vibeguard/vibeguard#rules",
              "properties": {
                "security_severity": "critical",
                "tags": [
                  "confidence:medium"
                ]
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "obf.curl-pipe-shell",
              "name": "Downloaded code piped into a shell",
              "shortDescription": {
                "text": "Downloaded code piped into a shell"
              },
              "fullDescription": {
                "text": "A network response is executed directly. The downloaded content can change after review and is not pinned by any hash."
              },
              "helpUri": "https://github.com/vibeguard/vibeguard#rules",
              "properties": {
                "security_severity": "critical",
                "tags": [
                  "confidence:high"
                ]
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "secret.high-entropy",
              "name": "High-entropy string (possible hardcoded secret)",
              "shortDescription": {
                "text": "High-entropy string (possible hardcoded secret)"
              },
              "fullDescription": {
                "text": "A long, high-entropy string is hardcoded here — it looks like a secret/token/key. If it is one, move it to an environment variable and rotate it."
              },
              "helpUri": "https://github.com/vibeguard/vibeguard#rules",
              "properties": {
                "security_severity": "high",
                "tags": [
                  "confidence:medium"
                ]
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "secret.high-entropy-token",
              "name": "High-entropy secret-like token",
              "shortDescription": {
                "text": "High-entropy secret-like token"
              },
              "fullDescription": {
                "text": "High-entropy string assigned to a key-like name — possible hardcoded API key or token."
              },
              "helpUri": "https://github.com/vibeguard/vibeguard#rules",
              "properties": {
                "security_severity": "high",
                "tags": [
                  "confidence:medium"
                ]
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "ast.command-injection",
              "name": "Shell exec with a non-literal command (AST-confirmed)",
              "shortDescription": {
                "text": "Shell exec with a non-literal command (AST-confirmed)"
              },
              "fullDescription": {
                "text": "exec() runs a dynamically built command — command injection."
              },
              "helpUri": "https://github.com/vibeguard/vibeguard#rules",
              "properties": {
                "security_severity": "high",
                "tags": [
                  "confidence:high"
                ]
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "crypto2026.math-random-token",
              "name": "Math.random()/random.random() for a token or OTP",
              "shortDescription": {
                "text": "Math.random()/random.random() for a token or OTP"
              },
              "fullDescription": {
                "text": "A predictor is used to generate a security token/OTP. Math.random() is seedable and observed output predicts the next value."
              },
              "helpUri": "https://github.com/vibeguard/vibeguard#rules",
              "properties": {
                "security_severity": "high",
                "tags": [
                  "confidence:high"
                ]
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "ai.eval-llm-output",
              "name": "Executing LLM output as code",
              "shortDescription": {
                "text": "Executing LLM output as code"
              },
              "fullDescription": {
                "text": "Model output is executed as code (eval/Function). A prompt-injected response becomes remote code execution."
              },
              "helpUri": "https://github.com/vibeguard/vibeguard#rules",
              "properties": {
                "security_severity": "high",
                "tags": [
                  "confidence:medium"
                ]
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "taint.cross-file",
              "name": "Request data flows across files into a sink (AST-confirmed)",
              "shortDescription": {
                "text": "Request data flows across files into a sink (AST-confirmed)"
              },
              "fullDescription": {
                "text": "Variable `token` carries request data from utils.jwtFrom() (from lib/utils.ts) into an outbound request — cross-file taint via return value assigned to a local."
              },
              "helpUri": "https://github.com/vibeguard/vibeguard#rules",
              "properties": {
                "security_severity": "high",
                "tags": [
                  "confidence:medium"
                ]
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "taint.ssrf",
              "name": "User input reaches an outbound request URL (dataflow-confirmed)",
              "shortDescription": {
                "text": "User input reaches an outbound request URL (dataflow-confirmed)"
              },
              "fullDescription": {
                "text": "A value derived from user input is used as an outbound request target — server-side request forgery (SSRF). (tainted via `source`)"
              },
              "helpUri": "https://github.com/vibeguard/vibeguard#rules",
              "properties": {
                "security_severity": "high",
                "tags": [
                  "confidence:high"
                ]
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "pii.secret-in-response",
              "name": "Secret/credential sent in an HTTP response",
              "shortDescription": {
                "text": "Secret/credential sent in an HTTP response"
              },
              "fullDescription": {
                "text": "A secret/credential field is included in an HTTP response body — it will be sent to the client."
              },
              "helpUri": "https://github.com/vibeguard/vibeguard#rules",
              "properties": {
                "security_severity": "high",
                "tags": [
                  "confidence:medium"
                ]
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "authz2026.orm-fetch-by-param-id-no-owner",
              "name": "Object fetched by request id with no ownership filter (IDOR)",
              "shortDescription": {
                "text": "Object fetched by request id with no ownership filter (IDOR)"
              },
              "fullDescription": {
                "text": "A record is fetched by an id that came straight from the request, with no owner/tenant predicate on the same query. Any authenticated user can read any row by changing the id (IDOR / BOLA)."
              },
              "helpUri": "https://github.com/vibeguard/vibeguard#rules",
              "properties": {
                "security_severity": "high",
                "tags": [
                  "confidence:medium"
                ]
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "ast.nosql-injection",
              "name": "NoSQL $where operator (AST-confirmed)",
              "shortDescription": {
                "text": "NoSQL $where operator (AST-confirmed)"
              },
              "fullDescription": {
                "text": "A query uses the $where operator, which executes JavaScript on the DB server — injection risk."
              },
              "helpUri": "https://github.com/vibeguard/vibeguard#rules",
              "properties": {
                "security_severity": "high",
                "tags": [
                  "confidence:high"
                ]
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "taint.xss-reflected",
              "name": "User input reaches an HTML response (dataflow-confirmed)",
              "shortDescription": {
                "text": "User input reaches an HTML response (dataflow-confirmed)"
              },
              "fullDescription": {
                "text": "A value derived from user input flows into res.send/write/end — reflected XSS. (tainted via `source`)"
              },
              "helpUri": "https://github.com/vibeguard/vibeguard#rules",
              "properties": {
                "security_severity": "high",
                "tags": [
                  "confidence:high"
