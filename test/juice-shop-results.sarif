              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "ast.path-traversal",
              "name": "Filesystem path from request (AST-confirmed)",
              "shortDescription": {
                "text": "Filesystem path from request (AST-confirmed)"
              },
              "fullDescription": {
                "text": "A request value is used to build a filesystem path — path traversal."
              },
              "helpUri": "https://github.com/vibeguard/vibeguard#rules",
              "properties": {
                "security_severity": "high",
