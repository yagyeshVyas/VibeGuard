            {
              "id": "taint.interprocedural",
              "name": "Request data flows through a function into a sink (AST-confirmed)",
              "shortDescription": {
                "text": "Request data flows through a function into a sink (AST-confirmed)"
              },
              "fullDescription": {
                "text": "Request data is passed to retrieveCodeSnippet(), which routes its argument into an outbound request — injection across a function boundary."
              },
              "helpUri": "https://github.com/vibeguard/vibeguard#rules",
              "properties": {
                "security_severity": "high",
