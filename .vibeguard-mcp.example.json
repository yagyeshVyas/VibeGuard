{
  "_comment": "VibeGuard MCP firewall policy. Copy to .vibeguard-mcp.json and edit. Strict default-deny is the default: add the tools you trust to allowTools. Use --allow-unknown only for a deliberate compatibility opt-out.",
  "version": 1,
  "defaultAction": "block",
  "toolRules": [
    { "match": "mcp__filesystem__write_*", "action": "warn", "reason": "review writes" }
  ],
  "denyTools": [],
  "allowTools": [],
  "approvalRequired": [],
  "blockedCapabilities": [],
  "allowedCapabilities": [],
  "allowedPaths": [],
  "deniedPaths": [
    "**/.env",
    "**/.env.*",
    "**/.ssh/**",
    "**/.aws/credentials",
    "**/.npmrc",
    "**/.netrc",
    "**/.git-credentials",
    "**/*.pem",
    "**/*.key",
    "**/id_rsa",
    "**/id_ed25519",
    "**/secrets/**",
    "**/credentials.json",
    "**/service-account*.json"
  ],
  "enforceProjectScope": true,
  "allowedHosts": [],
  "deniedHosts": [
    "169.254.169.254",
    "metadata.google.internal",
    "metadata.goog"
  ],
  "trustedHosts": [],
  "blockExternalNetwork": false,
  "secretScan": true,
  "allowSecretsInArgs": false,
  "piiScan": true,
  "piiMode": "warn",
  "blockPromptInjection": true,
  "pinToolDefinitions": true,
  "scrubToolResults": true,
  "blockToolResultInjection": true,
  "maxArgumentBytes": 65536,
  "maxCallsPerMinute": 240,
  "logAllowedCalls": true,
  "failClosed": true
}
